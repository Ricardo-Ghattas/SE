{
    "compilerOptions": {
        "target": "es6",
        "module": "commonjs",
        "lib": ["es2022"],
        "strict": true,
        "types": ["node", "jest"],
        "rootDir": ".",
        "outDir": "build",
        "sourceMap": true,
        "esModuleInterop": true
    },
    "include": ["src/**/*.ts", "tests/**/*.ts"],
    "exclude": ["node_modules"]
}
